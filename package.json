{
  "name": "toy-shop-showroom",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.17.0", "npm": "11.12.1" },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file=.env server/index.js",
    "dev:web": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "lint": "eslint client/src server scripts tests eslint.config.mjs",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "assets:demo": "node scripts/generate-demo-art.js",
    "bootstrap:admin": "node --env-file=.env scripts/bootstrap-super-admin.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "axios": "1.21.1",
    "bcrypt": "6.0.0",
    "cloudinary": "2.11.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.80.0",
    "multer": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prisma": "6.19.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
