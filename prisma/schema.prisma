generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminProfile {
  id           String    @id @default(uuid()) @db.Uuid
  fullName     String    @map("full_name") @db.VarChar(120)
  email        String    @unique @db.VarChar(254)
  username     String    @unique @db.VarChar(40)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String    @default("Admin") @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities   AdminActivity[]

  @@map("admin_profiles")
}

model ShopDetails {
  id             Int      @id @default(1) @db.SmallInt
  name           String?  @db.VarChar(160)
  description    String?  @db.VarChar(2000)
  logoUrl        String?  @map("logo_url") @db.VarChar(2048)
  logoPublicId   String?  @map("logo_public_id") @db.VarChar(255)
  address        String?  @db.VarChar(500)
  mapLocation    String?  @map("map_location") @db.VarChar(2048)
  phone          String?  @db.VarChar(40)
  whatsappNumber String?  @map("whatsapp_number") @db.VarChar(40)
  email          String?  @db.VarChar(254)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  openingHours   String?  @map("opening_hours") @db.VarChar(1000)

  @@map("shop_details")
}

model SocialLink {
  id        String         @id @default(uuid()) @db.Uuid
  platform  String   @db.Text
  url       String         @db.VarChar(2048)
  label     String?        @db.VarChar(80)
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sortOrder, platform])
  @@map("social_links")
}

model LoginRateLimit {
  keyHash String   @id @map("key_hash") @db.Char(64)
  hits    Int      @default(0)
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("login_rate_limits")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.VarChar(1000)
  sortOrder   Int       @default(0) @map("sort_order")
  isPublished Boolean   @default(true) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    Product[]

  @@index([isPublished, sortOrder, name])
  @@map("categories")
}

model Product {
  id             String              @id @default(uuid()) @db.Uuid
  name           String              @db.VarChar(160)
  slug           String              @unique @db.VarChar(120)
  categoryId     String?             @map("category_id") @db.Uuid
  price          Decimal             @db.Decimal(10, 2)
  images         String[]            @default([])
  description    String?             @db.Text
  ageGroup       String?             @map("age_group") @db.VarChar(40)
  stockQuantity  Int                 @default(0) @map("stock_quantity")
  availability   String              @default("in_stock") @db.Text
  isPublished    Boolean             @default(false) @map("is_published")
  isRare         Boolean             @default(false) @map("is_rare")
  isNew          Boolean             @default(false) @map("is_new")
  isRecommended  Boolean             @default(false) @map("is_recommended")
  isBestSeller   Boolean             @default(false) @map("is_best_seller")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  offerProducts  OfferProduct[]
  preBookings    PreBooking[]
  enquiries      Enquiry[]

  @@index([categoryId])
  @@index([isPublished, createdAt])
  @@index([isPublished, availability])
  @@index([isPublished, isRecommended, isRare, isNew])
  @@map("products")
}

model Offer {
  id          String         @id @default(uuid()) @db.Uuid
  title       String         @db.VarChar(160)
  description String?        @db.VarChar(2000)
  discountPercent Int        @default(0) @map("discount_percent")
  startsAt    DateTime       @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime       @map("ends_at") @db.Timestamptz(6)
  isPublished Boolean        @default(false) @map("is_published")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    OfferProduct[]

  @@index([isPublished, startsAt, endsAt])
  @@map("offers")
}

model OfferProduct {
  offerId   String   @map("offer_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([offerId, productId])
  @@index([productId])
  @@map("offer_products")
}

model PreBooking {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  customerName String   @map("customer_name") @db.VarChar(120)
  phone        String   @db.VarChar(40)
  email        String?  @db.VarChar(254)
  message      String?  @db.VarChar(1000)
  status       String   @default("Pending") @db.VarChar(20)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([productId])
  @@map("pre_bookings")
}

model Enquiry {
  id           String   @id @default(uuid()) @db.Uuid
  customerName String   @map("customer_name") @db.VarChar(120)
  email        String?  @db.VarChar(254)
  phone        String?  @db.VarChar(40)
  productId    String?  @map("product_id") @db.Uuid
  message      String   @db.VarChar(2000)
  status       String   @default("New") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("enquiries")
}

model NotificationSubscriber {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique @db.VarChar(254)
  consentedAt DateTime @map("consented_at") @db.Timestamptz(6)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([isActive, createdAt])
  @@map("notification_subscribers")
}

model AdminActivity {
  id         String        @id @default(uuid()) @db.Uuid
  adminId    String?       @map("admin_id") @db.Uuid
  action     String        @db.VarChar(80)
  targetType String        @map("target_type") @db.VarChar(80)
  targetId   String?       @map("target_id") @db.VarChar(80)
  details    String?       @db.VarChar(1000)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  admin      AdminProfile? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@map("admin_activities")
}
